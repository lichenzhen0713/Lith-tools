{
  "name": "lith-tools",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Lith Tools — 现代化多功能在线工具箱（70 个浏览器端工具 + 博客 + 论坛 + 管理后台）",
  "license": "MIT",
  "author": "Lith Tools contributors",
  "keywords": [
    "toolbox",
    "online-tools",
    "react",
    "fastify",
    "sqlite",
    "typescript",
    "self-hosted",
    "markdown"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "tools:check": "node scripts/tools-check.mjs",
    "verify:extras": "node scripts/verify-extras.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "docs:map": "node scripts/gen-url-map.mjs",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:reset": "tsx server/scripts/reset.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "dompurify": "^3.2.6",
    "fastify": "^5.6.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.544.0",
    "marked": "^16.3.0",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
