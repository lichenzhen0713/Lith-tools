# =============================================================================
#  Lith Tools 启动参数模板（面板部署用，与 LCZOJ 的 deploy/panel.env 一致）
#
#  用法（宝塔 / 小皮 / PM2 / systemd 都可照抄这里的键值对）：
#    1) 复制成 deploy/panel.env（这个文件名不会进版本库）
#    2) 按需修改下面的值
#    3) 用启动脚本加载：bash deploy/panel-start.sh
#       或在面板的「环境变量」里逐条填写同样的键值
#
#  也可以直接运行 node deploy/panel-install.js，由脚本生成 panel.env。
# =============================================================================

# 站点端口。面板的 80/443 一般被 Nginx 占用，所以应用用 8787，
# 再由面板站点反向代理：http://127.0.0.1:8787
PORT=8787

# 监听地址：127.0.0.1 = 只允许本机（Nginx 反代）访问，最安全；
# 要直接用 IP:端口 访问就改成 0.0.0.0
HOST=127.0.0.1

# 运行环境
NODE_ENV=production

# 对外访问地址；配置 HTTPS 后改成 https://你的域名
PUBLIC_ORIGIN=

# 位于 Nginx / Cloudflare 后面时保持 true
TRUST_PROXY=true

# HTTPS 部署请设为 true；本地 HTTP 测试设为 false
COOKIE_SECURE=false

# SQLite 数据库文件；默认 data/lith-tools.db，建议写绝对路径
# DB_PATH=/www/wwwroot/lith-tools/data/lith-tools.db

# ---------------------------------------------------------------------------
#  其他配置（SMTP / DeepSeek / LCZOJ 授权登录）放在项目根目录的 .env，
#  由 deploy/init-env.cjs 首次生成；panel.env 只放运行参数。
# ---------------------------------------------------------------------------
