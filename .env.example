# ---------------------------------------------------------------- 基础配置
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# 对外访问地址（用于邮件里的重置链接），留空则使用请求的 Host
PUBLIC_ORIGIN=
# 如果部署在 Nginx / Cloudflare 后面，设为 true 以信任 X-Forwarded-For
TRUST_PROXY=false
# SQLite 数据库文件路径，默认 ./data/lith-tools.db
DB_PATH=
SESSION_TTL_DAYS=30
# 生产环境默认给会话 Cookie 加 Secure（需要 HTTPS）。本地用 HTTP 测试生产构建时设为 false
COOKIE_SECURE=

# ------------------------------------------------------------ 首个管理员账户
# 仅当数据库中不存在任何超级管理员时才会创建
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ------------------------------------------------------------------ 邮件服务
# 不配置时，注册验证码会打印在服务端日志中（开发模式也会随接口返回）
# 管理后台 → 系统设置 可覆盖以下值，保存后立即生效
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------- AI 助手（DeepSeek）
# 配置后 /assistant 页面可用；密钥只保存在服务端，不会下发浏览器
# 管理后台 → 系统设置 可覆盖以下值，保存后立即生效
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# ------------------------------------------------- LCZOJ 授权登录（OAuth 2.0）
# 在 LCZOJ 的 .env / 环境变量里配置同一组 OJ_OAUTH_*（见 docs/OAUTH.md）。
# 不配置时登录页不显示「使用 LCZOJ 账号登录」，原有账号密码登录不受影响。
# LCZOJ 地址：默认 80 端口写 http://127.0.0.1；面板部署常用 3000 端口或独立域名
LCZOJ_BASE_URL=http://127.0.0.1
LCZOJ_CLIENT_ID=lith-tools
LCZOJ_CLIENT_SECRET=请替换为与 LCZOJ 相同的随机密钥
# 必须与 LCZOJ 的 OJ_OAUTH_REDIRECT_URIS 完全一致；留空时按请求 Host 自动推导
LCZOJ_REDIRECT_URI=http://127.0.0.1:8787/api/auth/lczoj/callback
LCZOJ_NAME=LCZOJ

# 首次启动是否写入示例博客 / 论坛内容
SEED_DEMO=true
