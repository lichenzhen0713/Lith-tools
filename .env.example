# ---------------------------------------------------------------- 基础配置
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# 对外访问地址（用于邮件里的重置链接），留空则使用请求的 Host
PUBLIC_ORIGIN=
# 如果部署在 Nginx / Cloudflare 后面，设为 true 以信任 X-Forwarded-For
TRUST_PROXY=false
# SQLite 数据库文件路径，默认 ./data/lith-tools.db
DB_PATH=
SESSION_TTL_DAYS=30
# 生产环境默认给会话 Cookie 加 Secure（需要 HTTPS）。本地用 HTTP 测试生产构建时设为 false
COOKIE_SECURE=

# ------------------------------------------------------------ 首个管理员账户
# 仅当数据库中不存在任何超级管理员时才会创建
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ------------------------------------------------------------------ 邮件服务
# 不配置时，注册验证码会打印在服务端日志中（开发模式也会随接口返回）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------- AI 助手（可选）
# 配置后 /assistant 页面可用；密钥只保存在服务端
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# 首次启动是否写入示例博客 / 论坛内容
SEED_DEMO=true
